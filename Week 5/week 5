Total Revenue =
SUM(Sales[Revenue])

Total Orders =
DISTINCTCOUNT(Sales[OrderID])

Total Customers =
DISTINCTCOUNT(Sales[CustomerID])

Average Order Value =
DIVIDE([Total Revenue], [Total Orders])

Current Month Revenue =
CALCULATE(
    [Total Revenue],
    MONTH(Sales[OrderDate]) = MONTH(TODAY()),
    YEAR(Sales[OrderDate]) = YEAR(TODAY())
)

Previous Month Revenue =
CALCULATE(
    [Total Revenue],
    PREVIOUSMONTH(Sales[OrderDate])
)

MoM Growth % =
DIVIDE(
    [Current Month Revenue] - [Previous Month Revenue],
    [Previous Month Revenue]
)

Revenue YTD =
TOTALYTD(
    [Total Revenue],
    Sales[OrderDate]
)

Revenue Per Customer =
DIVIDE(
    [Total Revenue],
    [Total Customers]
)

Revenue Per Order =
DIVIDE(
    [Total Revenue],
    [Total Orders]
)

Profit =
SUM(Sales[Revenue]) - SUM(Sales[Cost])

Profit Margin % =
DIVIDE(
    [Profit],
    [Total Revenue]
)
